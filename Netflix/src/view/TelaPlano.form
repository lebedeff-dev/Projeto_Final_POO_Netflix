<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="view.TelaPlano">
  <grid id="0fa10" binding="painelCampos" layout-manager="GridLayoutManager" row-count="6" column-count="2" same-size-horizontally="true" same-size-vertically="true" hgap="5" vgap="5">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <margin top="10" left="10" bottom="5" right="10"/>
    <children>
      <component id="b8f79" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Nome"/>
        </properties>
      </component>
      <component id="d61c1" class="javax.swing.JTextField" binding="campoNome">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="5ae3c" class="javax.swing.JLabel">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Descrição (automática)"/>
        </properties>
      </component>
      <component id="3d479" class="javax.swing.JTextField" binding="campoDescricao">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <editable value="false"/>
        </properties>
      </component>
      <component id="f877c" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Valor mensal"/>
        </properties>
      </component>
      <component id="aa10d" class="javax.swing.JTextField" binding="campoValorMensal">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
      </component>
      <component id="3a71b" class="javax.swing.JLabel">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Qualidade máxima"/>
        </properties>
      </component>
      <component id="d30c6" class="javax.swing.JComboBox" binding="comboQualidade">
        <constraints>
          <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="SD"/>
            <item value="HD"/>
            <item value="Full HD"/>
            <item value="4K UHD"/>
          </model>
        </properties>
      </component>
      <component id="6d5a7" class="javax.swing.JLabel">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Telas simultâneas"/>
        </properties>
      </component>
      <component id="5701b" class="javax.swing.JComboBox" binding="comboTelas">
        <constraints>
          <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="1"/>
            <item value="2"/>
            <item value="4"/>
          </model>
        </properties>
      </component>
      <component id="a01ee" class="javax.swing.JLabel">
        <constraints>
          <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Permite download"/>
        </properties>
      </component>
      <component id="6a598" class="javax.swing.JComboBox" binding="comboPermiteDownload">
        <constraints>
          <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <model>
            <item value="Sim"/>
            <item value="Nao"/>
          </model>
        </properties>
      </component>
    </children>
  </grid>
</form>
