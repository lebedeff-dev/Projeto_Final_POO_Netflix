<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="view.TelaConexao">
  <grid id="665be" binding="painelRaiz" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="b4bec" class="javax.swing.JLabel">
        <constraints border-constraint="North"/>
        <properties>
          <text value="  Informe os dados do MySQL instalado neste computador:"/>
        </properties>
      </component>
      <grid id="7d9d5" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="true" same-size-vertically="true" hgap="5" vgap="5">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <margin top="10" left="10" bottom="10" right="10"/>
        <children>
          <component id="7c364" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Servidor:"/>
            </properties>
          </component>
          <component id="e8e2b" class="javax.swing.JTextField" binding="campoServidor">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="74166" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Porta:"/>
            </properties>
          </component>
          <component id="f7712" class="javax.swing.JTextField" binding="campoPorta">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="11ab6" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Usuário:"/>
            </properties>
          </component>
          <component id="9382f" class="javax.swing.JTextField" binding="campoUsuario">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
          <component id="4ed0d" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Senha do MySQL:"/>
            </properties>
          </component>
          <component id="e2d86" class="javax.swing.JPasswordField" binding="campoSenha">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <component id="8ebaa" class="javax.swing.JButton" binding="btnConectar">
        <constraints border-constraint="South"/>
        <properties>
          <text value="Conectar"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
