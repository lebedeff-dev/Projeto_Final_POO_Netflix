<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="view.TelaPrincipal">
  <grid id="1c813" binding="painelRaiz" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="bc8e2" binding="painelBarra" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
        </children>
      </grid>
      <grid id="3025d" layout-manager="GridLayoutManager" row-count="5" column-count="1" same-size-horizontally="true" same-size-vertically="true" hgap="8" vgap="8">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <margin top="15" left="150" bottom="15" right="150"/>
        <children>
          <component id="6b554" class="javax.swing.JButton" binding="btnPlanos">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="1. Planos"/>
            </properties>
          </component>
          <component id="7a384" class="javax.swing.JButton" binding="btnContas">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="2. Contas"/>
            </properties>
          </component>
          <component id="d0ebc" class="javax.swing.JButton" binding="btnPerfis">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="3. Perfis"/>
            </properties>
          </component>
          <component id="822f8" class="javax.swing.JButton" binding="btnTitulos">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="4. Títulos"/>
            </properties>
          </component>
          <component id="f6bde" class="javax.swing.JButton" binding="btnHistorico">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="5. Histórico de Visualização"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
